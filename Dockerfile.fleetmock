FROM golang:1.26-alpine AS builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o /bin/fleetmock ./cmd/fleetmock

FROM alpine:3.19
RUN apk add --no-cache ca-certificates
COPY --from=builder /bin/fleetmock /bin/fleetmock
EXPOSE 8081
ENTRYPOINT ["/bin/fleetmock"]

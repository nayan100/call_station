FROM golang:1.26-alpine AS builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o /bin/callservice ./cmd/callservice

FROM alpine:3.19
RUN apk add --no-cache ca-certificates
COPY --from=builder /bin/callservice /bin/callservice
EXPOSE 8080
ENTRYPOINT ["/bin/callservice"]
